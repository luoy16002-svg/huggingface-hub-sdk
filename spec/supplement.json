  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "description": "A model repository on the Hub.",
        "properties": {
          "_id": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Repo id, namespace/name."
          },
          "author": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastModified": {
            "type": "string",
            "format": "date-time"
          },
          "private": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "gated": {
            "description": "false, or 'auto' / 'manual' when access needs approval."
          },
          "likes": {
            "type": "integer"
          },
          "trendingScore": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cardData": {
            "type": "object",
            "additionalProperties": true
          },
          "siblings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rfilename": {
                  "type": "string"
                }
              }
            }
          },
          "usedStorage": {
            "type": "integer"
          },
          "modelId": {
            "type": "string"
          },
          "downloads": {
            "type": "integer"
          },
          "pipeline_tag": {
            "type": "string"
          },
          "library_name": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "safetensors": {
            "type": "object",
            "additionalProperties": true
          },
          "spaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      },
