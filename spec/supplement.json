{
  "paths": {
    "/api/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List models",
        "description": "Search and list models on the Hub. Documented at https://huggingface.co/docs/hub/api.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Filter by a substring of the repo id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "description": "Filter by owner (user or organisation).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Filter by tag, for example a library, task or language tag.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Property to sort by, for example downloads, likes, trendingScore, createdAt or lastModified.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "description": "Sort direction; -1 for descending.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "full",
            "in": "query",
            "required": false,
            "description": "Return the full record for each result.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching models.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Model"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/models/{namespace}/{repo}": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Get model info",
        "description": "Information about one model repository. Documented at https://huggingface.co/docs/hub/api.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "description": "Owner (user or organisation).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "description": "Repository name.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or private without access."
          }
        }
      }
    },
