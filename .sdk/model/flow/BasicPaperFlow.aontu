# BasicPaperFlow

main: kit: flow: BasicPaperFlow:
{
  entity: "paper",
  kind: "basic",
  name: "BasicPaperFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "paper_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "paper_ref01",
        srcdatavar: "paper_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "paper01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-paper_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaperFlow"
}